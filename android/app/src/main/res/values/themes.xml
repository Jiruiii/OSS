<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ResilientGeoMesh" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Module B's MainActivity uses AppCompatActivity + Material Components
      views (RecyclerView, Toast styling, etc.), which require a
      Theme.AppCompat/MaterialComponents-derived theme — the app-level
      Theme.ResilientGeoMesh above extends the plain platform theme instead,
      because BleSpikeActivity (a bare ComponentActivity) doesn't need
      AppCompat. This activity-scoped override keeps both requirements
      without forcing one activity's theme choice onto the other.
    -->
    <style name="Theme.ResilientGeoMesh.OfflineGis" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorPrimaryDark">#0D47A1</item>
        <item name="colorAccent">#4FC3F7</item>
    </style>
</resources>