<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Bluetooth is the only radio this app uses.

      ADR-001 rejected both Wi-Fi-based candidates after real-device
      testing (Nearby Connections returned a Google-side INTERNAL_ERROR;
      native Wi-Fi Direct's TCP transfer never completed), and their
      implementations have been removed along with the permissions they
      required — ACCESS_WIFI_STATE, CHANGE_WIFI_STATE, NEARBY_WIFI_DEVICES,
      CHANGE_WIFI_MULTICAST_STATE and INTERNET are deliberately absent. The
      rejected code remains in git history and the full measurement record
      is in docs/adr/ADR-001-transport-layer.md; keeping the permissions
      installed for code nothing calls would contradict this project's
      central claim that it works with no network infrastructure at all.

      ACCESS_FINE_LOCATION is retained because BLE scanning still requires
      it on API 30 and below (minSdk here is 26); on API 31+ the
      neverForLocation flag on BLUETOOTH_SCAN is what applies.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Emergency Mode foreground service: holds the process up so BLE
         discovery keeps running with the screen off. ADR-001 measured 0/19
         successful locked-screen connections without one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ResilientGeoMesh">

        <!--
          MainActivity (the offline-GIS screen) is the product surface and
          therefore the launcher. Every other activity is a developer
          harness reached from a button on it.

          All of them are android:exported="false": none is meant to be
          started by another app, and several turn on BLE advertising, so
          leaving them exported handed any installed app a way to trigger
          that. `adb shell am start` still works on non-exported components
          because the shell user holds START_ANY_ACTIVITY, so the existing
          device-test workflow is unaffected.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ResilientGeoMesh.OfflineGis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".transport.BleSpikeActivity"
            android:exported="false" />

        <activity
            android:name=".transport.BleGattTransportSpikeActivity"
            android:exported="false" />

        <!-- Phase 0 measurement harness: contact-window sizing, connection
             success rate, energy capture (see ADR-001's backfilled data). -->
        <activity
            android:name=".transport.BleGattMeasurementActivity"
            android:exported="false" />

        <!-- The 3a milestone: two devices run
             HELLO/DIFF/REQUEST/TRANSFER/VERIFY-APPLY over BleGattTransport.
             Reachable from a button on MainActivity so the project's core
             capability can be demonstrated from the installed app, not only
             over adb. -->
        <activity
            android:name=".transport.PeerSyncMilestoneActivity"
            android:exported="false" />

        <service
            android:name=".emergency.EmergencyModeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
