<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The Google Maps provider is an optional online presentation layer. It
      requires INTERNET only while available; the Flutter renderer falls back
      to packaged OSM tiles when it has no network or no configured key.

      ADR-001 still rejects Wi-Fi transport: ACCESS_WIFI_STATE,
      CHANGE_WIFI_STATE, NEARBY_WIFI_DEVICES and CHANGE_WIFI_MULTICAST_STATE
      remain absent. BLE and Room continue to work with no network
      infrastructure.

      Fine/coarse location is requested only after the person selects the
      current-location control. Fine location also remains necessary for BLE
      scanning on API 30 and below; BLUETOOTH_SCAN's neverForLocation flag
      applies on API 31+.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Emergency Mode foreground service: holds the process up so BLE
         discovery keeps running with the screen off. ADR-001 measured 0/19
         successful locked-screen connections without one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ResilientGeoMesh">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />

        <!--
          MainActivity (the offline-GIS screen) is the product surface and
          therefore the launcher. Every other activity is a developer
          harness reached from a button on it.

          All of them are android:exported="false" here: none is meant to
          be started by another app, and several turn on BLE advertising,
          so leaving them exported handed any installed app a way to
          trigger that.

          This does break `adb shell am start` — the shell user does NOT
          hold START_ANY_ACTIVITY on these devices, verified on the Pixel 7
          ("Permission Denial ... not exported from uid 10262"). Since the
          Stage 0, contact-window, connection-rate and energy workflows all
          drive these screens over adb, src/debug/AndroidManifest.xml
          re-exports them for the debug variant only. Release builds expose
          nothing; the debug APK the team flashes keeps the adb workflow.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ResilientGeoMesh.OfflineGis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".transport.BleSpikeActivity"
            android:exported="false" />

        <activity
            android:name=".transport.BleGattTransportSpikeActivity"
            android:exported="false" />

        <!-- Phase 0 measurement harness: contact-window sizing, connection
             success rate, energy capture (see ADR-001's backfilled data). -->
        <activity
            android:name=".transport.BleGattMeasurementActivity"
            android:exported="false" />

        <!-- The 3a milestone: two devices run
             HELLO/DIFF/REQUEST/TRANSFER/VERIFY-APPLY over BleGattTransport.
             Reachable from a button on MainActivity so the project's core
             capability can be demonstrated from the installed app, not only
             over adb. -->
        <activity
            android:name=".transport.PeerSyncMilestoneActivity"
            android:exported="false" />

        <service
            android:name=".emergency.EmergencyModeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
