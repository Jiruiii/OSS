{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilientgeo.mesh/schemas/layer-chunk-v0.schema.json",
  "title": "ResilientGeo Mesh Layer Chunk v0",
  "description": "A signed transfer unit containing a subset of Feature v0 records.",
  "$comment": "This contract is separate from chunk-v0. Feature records remain individually signed and the chunk is bound to a verified layer manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunk_id",
    "manifest_id",
    "manifest_hash",
    "dataset_id",
    "layer_id",
    "namespace",
    "dataset_version",
    "sequence",
    "priority",
    "created_at",
    "content_type",
    "content_encoding",
    "feature_count",
    "byte_length",
    "chunk_hash",
    "features",
    "signature",
    "signature_algorithm",
    "signing_key_id"
  ],
  "properties": {
    "schema_version": {"const": "layer-chunk-v0"},
    "chunk_id": {"$ref": "#/$defs/identifier256"},
    "manifest_id": {"$ref": "#/$defs/identifier256"},
    "manifest_hash": {"$ref": "#/$defs/sha256"},
    "dataset_id": {"$ref": "#/$defs/identifier128"},
    "layer_id": {"$ref": "#/$defs/identifier128"},
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,31}$"
    },
    "dataset_version": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "priority": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "NORMAL", "LOW"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_type": {"const": "application/json"},
    "content_encoding": {
      "type": "string",
      "enum": ["identity", "gzip"]
    },
    "feature_count": {
      "type": "integer",
      "minimum": 1
    },
    "byte_length": {
      "type": "integer",
      "minimum": 1
    },
    "chunk_hash": {"$ref": "#/$defs/sha256"},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "feature-v0.schema.json"}
    },
    "signature": {"$ref": "#/$defs/signature"},
    "signature_algorithm": {"const": "Ed25519"},
    "signing_key_id": {"$ref": "#/$defs/identifier128"}
  },
  "$defs": {
    "identifier128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "identifier256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 4,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
