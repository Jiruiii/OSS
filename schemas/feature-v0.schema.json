{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilientgeo.mesh/schemas/feature-v0.schema.json",
  "title": "ResilientGeo Mesh Feature v0",
  "description": "A signed static spatial feature for an offline layer.",
  "$comment": "The logical identity is (namespace, layer_id, feature_id). Source-specific values remain in properties. Provenance is transport audit metadata and is not part of the canonical feature payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "dataset_id",
    "layer_id",
    "feature_id",
    "feature_type",
    "geometry",
    "properties",
    "source",
    "source_version",
    "issued_at",
    "expires_at",
    "payload_hash",
    "signature",
    "signature_algorithm",
    "signing_key_id",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "feature-v0"
    },
    "namespace": {
      "type": "string",
      "description": "Trust and overwrite boundary; official and unverified records use different namespaces.",
      "pattern": "^[a-z][a-z0-9._-]{0,31}$"
    },
    "dataset_id": {
      "$ref": "#/$defs/identifier128"
    },
    "layer_id": {
      "$ref": "#/$defs/identifier128"
    },
    "feature_id": {
      "$ref": "#/$defs/identifier256"
    },
    "feature_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "geometry": {
      "$ref": "#/$defs/geometry"
    },
    "properties": {
      "type": "object",
      "description": "Source-specific fields included in the signed canonical payload.",
      "additionalProperties": true
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload_hash": {
      "$ref": "#/$defs/sha256"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "signing_key_id": {
      "$ref": "#/$defs/identifier128"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "identifier128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "identifier256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "description": "Base64-encoded Ed25519 signature over the canonical feature payload and payload_hash.",
      "minLength": 4,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "lineCoordinates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "polygonCoordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/linearRing"
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Point"},
        "coordinates": {"$ref": "#/$defs/position"}
      }
    },
    "lineString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "LineString"},
        "coordinates": {"$ref": "#/$defs/lineCoordinates"}
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Polygon"},
        "coordinates": {"$ref": "#/$defs/polygonCoordinates"}
      }
    },
    "multiPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "MultiPoint"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/position"}
        }
      }
    },
    "multiLineString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "MultiLineString"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lineCoordinates"}
        }
      }
    },
    "multiPolygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "MultiPolygon"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/polygonCoordinates"}
        }
      }
    },
    "geometryCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "geometries"],
      "properties": {
        "type": {"const": "GeometryCollection"},
        "geometries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/geometry"}
        }
      }
    },
    "geometry": {
      "oneOf": [
        {"$ref": "#/$defs/point"},
        {"$ref": "#/$defs/lineString"},
        {"$ref": "#/$defs/polygon"},
        {"$ref": "#/$defs/multiPoint"},
        {"$ref": "#/$defs/multiLineString"},
        {"$ref": "#/$defs/multiPolygon"},
        {"$ref": "#/$defs/geometryCollection"}
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_source", "received_at", "transport_source"],
      "properties": {
        "original_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "transport_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["upstream", "server", "peer", "local_fixture"]
            },
            "node_id": {
              "$ref": "#/$defs/identifier128"
            }
          }
        }
      }
    }
  }
}
