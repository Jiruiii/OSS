{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilientgeo.mesh/schemas/peer-summary-v0.schema.json",
  "title": "ResilientGeo Mesh Peer Summary v0",
  "description": "The compact inventory exchanged in HELLO before chunk negotiation.",
  "$comment": "A Peer Summary is an inventory hint, not proof of data validity. Manifest and chunk signatures must still be verified before APPLY.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "node_id",
    "generated_at",
    "capabilities",
    "datasets"
  ],
  "properties": {
    "schema_version": {
      "const": "peer-summary-v0"
    },
    "protocol_version": {
      "const": "0"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_transports",
        "transfer_transports",
        "max_peer_count",
        "supports_resume",
        "max_chunk_bytes"
      ],
      "properties": {
        "discovery_transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/transport"
          }
        },
        "transfer_transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/transport"
          }
        },
        "max_peer_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "supports_resume": {
          "type": "boolean"
        },
        "max_chunk_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "transport": {
      "type": "string",
      "enum": [
        "BLE",
        "WIFI_DIRECT",
        "NEARBY_CONNECTIONS"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "namespace",
        "manifest_id",
        "manifest_hash",
        "dataset_version",
        "chunks"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,31}$"
        },
        "manifest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
        },
        "manifest_hash": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_version": {
          "type": "integer",
          "minimum": 1
        },
        "chunks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/chunk_summary"
          }
        }
      }
    },
    "chunk_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "chunk_hash",
        "size_bytes",
        "priority",
        "state"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
        },
        "chunk_hash": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "CRITICAL",
            "HIGH",
            "NORMAL",
            "LOW"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "expired"
          ]
        }
      }
    }
  }
}
