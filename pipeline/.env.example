# TDX HTTP API credentials. Fill the local .env, not this file.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# TDX Road Events API endpoints.
TDX_API_ENDPOINT=https://tdx.transportdata.tw/api/basic/v1/Traffic/RoadEvent/LiveEvent/City/Taipei?$format=JSON
TDX_TOKEN_ENDPOINT=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token

# CWA Open Data API. The key is sent only to the configured CWA endpoint.
CWA_API_KEY=
CWA_EARTHQUAKE_ENDPOINT=https://opendata.cwa.gov.tw/api/v1/rest/datastore/E-A0015-001
CWA_WARNING_ENDPOINT=https://opendata.cwa.gov.tw/api/v1/rest/datastore/W-C0033-001

# Optional NCDR authenticated alert datastore. Leave blank until the account is
# approved and the concrete datastore route is confirmed in account docs.
NCDR_API_KEY=
NCDR_API_ENDPOINT=

# Static source endpoints. These are public defaults and can be overridden for
# a mirror or a reviewed snapshot service.
OSM_API_ENDPOINT=https://overpass-api.de/api/interpreter
SHELTER_DATA_ENDPOINT=https://opdadm.moi.gov.tw/api/v1/no-auth/resource/api/dataset/ED6CF735-6C03-4573-A882-72C1BEC799CB/resource/54550E2F-4567-4C8F-BD2E-E54E9D0386B8/download
MEDICAL_DATA_ENDPOINT=https://data.taipei/api/v1/dataset/04a3d195-ee97-467a-b066-e471ff99d15d?scope=resourceAquire
