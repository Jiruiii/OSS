        "text-ignore-placement": false,
        "text-padding": 3,
        "symbol-sort-key": ["coalesce", ["get", "sort_rank"], 99]
      },
      "paint": {"text-color": "#f1b15b", "text-halo-color": "#171b20", "text-halo-width": 1}
    },
